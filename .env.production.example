# Public-IP HTTP demo. Copy to .env.production, then edit frontend origins.
API_IMAGE=woowangthon-api:local
API_BIND_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
WORKER_CONCURRENCY=1
PASSWORD_RESET_DELIVERY=disabled
OPENAI_API_KEY=
# Use model IDs available to your OpenAI project.
OPENAI_EXTRACTION_MODEL=gpt-6-luna
OPENAI_EXPLANATION_MODEL=gpt-6-luna
OPENAI_CHAT_MODEL=gpt-6-luna
MODEL_CONFIG_VERSION=luna-v1
AI_TIMEOUT_SECONDS=120
