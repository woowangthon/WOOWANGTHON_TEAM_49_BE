          ],
          "default": null,
          "title": "Rhs"
        },
        "unit": {
          "default": "KRW",
          "title": "Unit",
          "type": "string"
        },
        "delta": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
